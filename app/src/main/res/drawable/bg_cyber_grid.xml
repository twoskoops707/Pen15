<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0D0F" />
        </shape>
    </item>
    
    <!-- Grid pattern -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#00FF8808"
                android:centerColor="#00000000"
                android:endColor="#00FF8808" />
        </shape>
    </item>
    
    <!-- Top glow -->
    <item android:top="-100dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:centerX="0.5"
                android:centerY="0"
                android:startColor="#00FF8822"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>