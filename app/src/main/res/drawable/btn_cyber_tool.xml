<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1C1C26"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2dp" android:color="#00FFFF"/>
        </shape>
    </item>

    <!-- Disabled -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0E0E14"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#1A1A24"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14141C"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#2A2A38"/>
        </shape>
    </item>
</selector>
