<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2000E5FF"
                android:centerColor="#1000FF88"
                android:endColor="#2000B4D8"
                android:type="linear"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#100A1420"
                android:centerColor="#100C1822"
                android:endColor="#100E1C1C"
                android:type="linear"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#0000E5FF"
                android:centerColor="#0800E5FF"
                android:endColor="#0000E5FF"
                android:type="linear"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</layer-list>
