<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PentestDashboard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:colorBackground">@color/bg_deep</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorSurfaceVariant">@color/bg_elevated</item>
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryVariant">@color/neon_blue</item>
        <item name="colorOnPrimary">@color/bg_deep</item>
        <item name="colorSecondary">@color/neon_pink</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/neon_red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Big Action Button Style -->
    <style name="BigActionButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Category Card Style -->
    <style name="CategoryCard">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">2dp</item>
    </style>
</resources>
