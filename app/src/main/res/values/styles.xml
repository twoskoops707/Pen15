<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tool Button Style (old) -->
    <style name="ToolButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:enabled">false</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Tool Button Style (new compact) -->
    <style name="ToolBtn" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:enabled">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Dark Dialog Theme -->
    <style name="DarkDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">#1A1A1F</item>
        <item name="android:textColor">#E5E7EB</item>
        <item name="android:textColorPrimary">#E5E7EB</item>
        <item name="android:textColorSecondary">#9CA3AF</item>
        <item name="colorSurface">#1A1A1F</item>
        <item name="colorOnSurface">#E5E7EB</item>
        <item name="colorPrimary">#3B82F6</item>
    </style>

</resources>
