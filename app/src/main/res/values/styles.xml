<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Input fields -->
    <style name="Widget.Pen15.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/primary_dim</item>
        <item name="android:textColorHint">@color/primary_dim</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Pen15.SmallComponent</item>
    </style>

    <style name="ShapeAppearance.Pen15.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- Chip / Badge -->
    <style name="Widget.Pen15.Chip.Status" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textSize">11sp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>

    <!-- Dividers -->
    <style name="Widget.Pen15.Divider" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/border</item>
        <item name="android:layout_marginVertical">12dp</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.Pen15.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/background</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
    </style>

    <!-- Dashboard card base style -->
    <style name="Widget.Pen15.DashCard" parent="android:Widget">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- Section header text -->
    <style name="Widget.Pen15.SectionLabel" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.15</item>
    </style>
</resources>
