<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Section header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SEARCH FOR A PERSON"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fill in what you know. More info = more targeted results."
        android:textColor="#7878A0"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"/>

    <!-- Input Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0E0E1C"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <!-- Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name  (required)"
            android:textColor="#EAEAF0"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/personName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="John Smith"
            android:textColor="#EAEAF0"
            android:textColorHint="#3A3A58"
            android:background="#0A0A14"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp"
            android:inputType="textPersonName"
            android:layout_marginBottom="12dp"/>

        <!-- Location -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location  (optional)"
            android:textColor="#EAEAF0"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/personLocation"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="New York, NY"
            android:textColor="#EAEAF0"
            android:textColorHint="#3A3A58"
            android:background="#0A0A14"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <!-- Employer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Employer  (optional)"
            android:textColor="#EAEAF0"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/personEmployer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Acme Corp"
            android:textColor="#EAEAF0"
            android:textColorHint="#3A3A58"
            android:background="#0A0A14"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <!-- File Type Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="File Type  (optional — narrows to specific document formats)"
            android:textColor="#EAEAF0"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/personFileType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#0A0A14"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="4dp"/>

    </LinearLayout>

    <!-- Generate Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/personGenerate"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="GENERATE DORKS"
        android:textColor="#0A0A14"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textSize="13sp"
        app:backgroundTint="#00E5FF"
        app:cornerRadius="4dp"
        android:layout_marginBottom="16dp"/>

    <!-- Results Card -->
    <LinearLayout
        android:id="@+id/personResultsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0E0E1C"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GENERATED QUERIES"
            android:textColor="#7878A0"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp"/>

        <!-- Query list container — rows added dynamically -->
        <LinearLayout
            android:id="@+id/personQueryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <!-- Bottom action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/personSaveAll"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="SAVE ALL"
                android:textColor="#00FF88"
                android:textSize="12sp"
                android:fontFamily="monospace"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#00FF88"
                app:strokeWidth="1dp"
                app:cornerRadius="4dp"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/personCopyAll"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="COPY ALL"
                android:textColor="#00B4D8"
                android:textSize="12sp"
                android:fontFamily="monospace"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#00B4D8"
                app:strokeWidth="1dp"
                app:cornerRadius="4dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
