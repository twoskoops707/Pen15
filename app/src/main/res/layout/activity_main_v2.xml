<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0F"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#0F0F14">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PEN15"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFLINE"
            android:textSize="12sp"
            android:textColor="@color/gray"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

    </LinearLayout>

    <!-- Device Info -->
    <TextView
        android:id="@+id/deviceInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No device"
        android:textSize="13sp"
        android:textColor="#6B7280"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:background="#0F0F14"/>

    <!-- Connect Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:text="CONNECT"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#2563EB"
        app:cornerRadius="12dp"
        app:rippleColor="#3B82F6"/>

    <!-- Terminal Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#111116"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#1F1F28"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Terminal Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#0D0D12">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_green"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Terminal"
                    android:textSize="12sp"
                    android:textColor="#6B7280"/>

            </LinearLayout>

            <!-- Terminal Output -->
            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/outputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"
                    android:textIsSelectable="true"/>

            </ScrollView>

            <!-- Input Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#0D0D12">

                <EditText
                    android:id="@+id/inputField"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/input_bg"
                    android:hint="Enter command..."
                    android:textColorHint="#4B5563"
                    android:textColor="#E5E7EB"
                    android:textSize="14sp"
                    android:paddingHorizontal="12dp"
                    android:fontFamily="monospace"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:enabled="false"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="SEND"
                    android:textSize="13sp"
                    app:backgroundTint="#374151"
                    app:cornerRadius="8dp"
                    android:enabled="false"/>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tool Buttons Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOOLS"
            android:textSize="11sp"
            android:textColor="#6B7280"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRfid"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="RFID"
                android:textSize="12sp"
                android:textColor="#FB923C"
                app:backgroundTint="#1C1510"
                app:cornerRadius="10dp"
                android:enabled="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubghz"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="SubGHz"
                android:textSize="12sp"
                android:textColor="#A78BFA"
                app:backgroundTint="#16101C"
                app:cornerRadius="10dp"
                android:enabled="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIbutton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="iButton"
                android:textSize="12sp"
                android:textColor="#14B8A6"
                app:backgroundTint="#0D1816"
                app:cornerRadius="10dp"
                android:enabled="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIr"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="IR"
                android:textSize="12sp"
                android:textColor="#EC4899"
                app:backgroundTint="#1C0D14"
                app:cornerRadius="10dp"
                android:enabled="false"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
