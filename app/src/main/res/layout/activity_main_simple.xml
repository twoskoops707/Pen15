<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black">

    <!-- Sleek Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:gravity="center_vertical"
        android:background="@color/void_deep"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PEN15"
            android:textSize="24sp"
            android:textColor="@color/accent_primary"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"/>

        <!-- Status Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/status_pill_bg"
            android:paddingHorizontal="12dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/indicator_status"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:progressTint="@color/accent_primary"
        app:layout_constraintTop_toBottomOf="@id/header"/>

    <!-- Result Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/resultCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/resultType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAPTURED"
                android:textSize="11sp"
                android:textColor="@color/accent_secondary"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"/>

            <TextView
                android:id="@+id/resultId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="28sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"/>

            <TextView
                android:id="@+id/resultExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="monospace"
                android:gravity="center"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Main Content -->
    <ScrollView
        android:id="@+id/menuScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/resultCard"
        app:layout_constraintBottom_toTopOf="@id/terminalSection">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Connect Button - Hero -->
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CONNECT"
                android:textSize="16sp"
                android:textColor="@color/void_black"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:background="@drawable/btn_primary"
                android:layout_marginBottom="20dp"/>

            <!-- WiFi Marauder Section -->
            <include layout="@layout/section_wifi"/>

            <!-- RFID Section -->
            <include layout="@layout/section_rfid"/>

            <!-- SubGHz Section -->
            <include layout="@layout/section_subghz"/>

            <!-- NFC Section -->
            <include layout="@layout/section_nfc"/>

            <!-- Other Tools Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- iButton -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="iBTN"
                        android:textSize="11sp"
                        android:textColor="@color/tool_gpio"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>

                    <Button
                        android:id="@+id/btnIButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Read"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:background="@drawable/btn_tool"
                        android:layout_marginTop="8dp"
                        android:enabled="false"/>
                </LinearLayout>

                <!-- Infrared -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IR"
                        android:textSize="11sp"
                        android:textColor="@color/tool_infrared"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>

                    <Button
                        android:id="@+id/btnIR"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Learn"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:background="@drawable/btn_tool"
                        android:layout_marginTop="8dp"
                        android:enabled="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Debug -->
            <Button
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="TEST CLI"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:fontFamily="monospace"
                android:background="@drawable/btn_subtle"
                android:layout_marginTop="16dp"
                android:enabled="false"/>

        </LinearLayout>
    </ScrollView>

    <!-- Terminal Section -->
    <LinearLayout
        android:id="@+id/terminalSection"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="vertical"
        android:background="@color/void_deep"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="@color/accent_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TERMINAL"
                android:textSize="10sp"
                android:textColor="@color/text_tertiary"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/outputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_terminal"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:text=""
                android:textIsSelectable="true"/>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
