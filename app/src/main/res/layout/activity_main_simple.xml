<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F12"
    android:fitsSystemWindows="true">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F0F12"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Logo/Title -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PEN15"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:paddingStart="12dp"/>

                <!-- Status Chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/statusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Offline"
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"
                    app:chipBackgroundColor="#1A1A1F"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="0dp"
                    app:chipMinHeight="32dp"
                    app:chipIconSize="8dp"
                    app:chipIcon="@drawable/indicator_status"
                    app:chipIconTint="#6B7280"
                    app:chipIconVisible="true"
                    app:closeIconVisible="false"
                    app:ensureMinTouchTargetSize="false"/>

                <!-- Help Button -->
                <ImageButton
                    android:id="@+id/btnHelp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_help"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#9CA3AF"
                    android:contentDescription="Help"
                    android:padding="8dp"/>

                <!-- Settings Button -->
                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_settings"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#9CA3AF"
                    android:contentDescription="Settings"
                    android:padding="8dp"/>

            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Progress Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="#3B82F6"
            app:trackColor="#1F2937"
            app:trackThickness="2dp"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/menuScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="200dp">

            <!-- Connect Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1A1A1F"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Device Connection"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnect"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Connect to Flipper"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        android:textAllCaps="false"
                        app:backgroundTint="#3B82F6"
                        app:cornerRadius="12dp"
                        app:rippleColor="#2563EB"
                        app:icon="@drawable/ic_usb"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="#FFFFFF"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Result Card (Hidden by default) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="#1A1A1F"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#22C55E"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/resultType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CAPTURED"
                        android:textSize="11sp"
                        android:textColor="#22C55E"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/resultId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="24sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:textIsSelectable="true"/>

                    <TextView
                        android:id="@+id/resultExtra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#9CA3AF"
                        android:gravity="center"
                        android:visibility="gone"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- WiFi Section -->
            <include layout="@layout/section_wifi"/>

            <!-- RFID Section -->
            <include layout="@layout/section_rfid"/>

            <!-- SubGHz Section -->
            <include layout="@layout/section_subghz"/>

            <!-- NFC Section -->
            <include layout="@layout/section_nfc"/>

            <!-- Other Tools -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1A1A1F"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OTHER TOOLS"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:letterSpacing="0.08"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <!-- iButton -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="iButton"
                            android:textSize="13sp"
                            android:textColor="#14B8A6"
                            android:textAllCaps="false"
                            app:backgroundTint="#0D3D38"
                            app:cornerRadius="10dp"
                            app:rippleColor="#14B8A6"
                            android:enabled="false"/>

                        <!-- Infrared -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIR"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Infrared"
                            android:textSize="13sp"
                            android:textColor="#EC4899"
                            android:textAllCaps="false"
                            app:backgroundTint="#3D0D29"
                            app:cornerRadius="10dp"
                            app:rippleColor="#EC4899"
                            android:enabled="false"/>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Debug Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Test CLI Connection"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:textAllCaps="false"
                app:cornerRadius="10dp"
                app:strokeColor="#27272A"
                app:strokeWidth="1dp"
                android:enabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Terminal Sheet -->
    <LinearLayout
        android:id="@+id/terminalSection"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:orientation="vertical"
        android:background="@drawable/terminal_bg"
        android:padding="16dp"
        android:layout_gravity="bottom"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/terminal_dot"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Terminal"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:layout_marginStart="8dp"/>

            <ImageButton
                android:id="@+id/btnClearTerminal"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_clear"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#4B5563"
                android:contentDescription="Clear"
                android:padding="4dp"/>

        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <TextView
                android:id="@+id/outputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:text=""
                android:textIsSelectable="true"/>
        </ScrollView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
