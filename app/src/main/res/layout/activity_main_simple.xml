<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PEN15"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:fontFamily="monospace"/>

        <!-- Connection Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/indicator_status"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="monospace"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:progressTint="@color/accent_primary"
        app:layout_constraintTop_toBottomOf="@id/header"/>

    <!-- Result Card (shows scan results at top) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/resultCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/resultType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCAN RESULT"
                android:textSize="10sp"
                android:textColor="@color/accent_secondary"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/resultId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:textIsSelectable="true"/>

            <TextView
                android:id="@+id/resultExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="monospace"
                android:gravity="center"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Menu ScrollView -->
    <ScrollView
        android:id="@+id/menuScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/resultCard"
        app:layout_constraintBottom_toTopOf="@id/terminalSection">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- CONNECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="CONNECT USB"
                    android:textSize="14sp"
                    android:textColor="@color/void_black"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@color/accent_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect Flipper Zero via USB-C"
                    android:textSize="11sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- RFID Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RFID 125kHz"
                    android:textSize="12sp"
                    android:textColor="@color/tool_rfid"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <Button
                    android:id="@+id/btnRFID"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Read Card"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:background="@color/surface_elevated"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:layout_marginTop="8dp"
                    android:enabled="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EM4100, HID, Indala, AWID cards"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- SUB-GHZ Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sub-GHz"
                    android:textSize="12sp"
                    android:textColor="@color/tool_subghz"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <Button
                    android:id="@+id/btnSubGHz"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Receive 433MHz"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:background="@color/surface_elevated"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:layout_marginTop="8dp"
                    android:enabled="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Garage doors, remotes, sensors"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- NFC Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NFC 13.56MHz"
                    android:textSize="12sp"
                    android:textColor="@color/tool_nfc"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <Button
                    android:id="@+id/btnNFC"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Detect Tag"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:background="@color/surface_elevated"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:layout_marginTop="8dp"
                    android:enabled="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MIFARE, NTAG, credit cards"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- iButton Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="iButton"
                    android:textSize="12sp"
                    android:textColor="@color/tool_gpio"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <Button
                    android:id="@+id/btnIButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Read Key"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:background="@color/surface_elevated"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:layout_marginTop="8dp"
                    android:enabled="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dallas, Cyfral, Metakom keys"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Infrared Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Infrared"
                    android:textSize="12sp"
                    android:textColor="@color/tool_infrared"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <Button
                    android:id="@+id/btnIR"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Learn Remote"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:background="@color/surface_elevated"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:layout_marginTop="8dp"
                    android:enabled="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TVs, ACs, projectors"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- CLI Test -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/surface_card"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Debug"
                    android:textSize="12sp"
                    android:textColor="@color/text_tertiary"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>

                <Button
                    android:id="@+id/btnTest"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Test CLI Connection"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:background="@color/surface_elevated"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:layout_marginTop="8dp"
                    android:enabled="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verify Flipper CLI responds"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Terminal Section (compact, at bottom) -->
    <LinearLayout
        android:id="@+id/terminalSection"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:background="@color/surface_dark"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OUTPUT"
            android:textSize="9sp"
            android:textColor="@color/text_tertiary"
            android:fontFamily="monospace"/>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/outputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_terminal"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp"
                android:text=""
                android:textIsSelectable="true"
                android:maxLines="30"/>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
