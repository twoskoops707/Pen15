<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grid_pattern">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:elevation="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/info"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SUB-GHZ"
                android:textColor="@color/danger"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginStart="12dp"/>

            <TextView
                android:id="@+id/frequencyDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="433.92"
                android:textColor="@color/warning"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:background="#22FFFF00"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>

            <ImageView
                android:id="@+id/btnHelp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_help"
                android:tint="@color/text_secondary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Help"/>
        </LinearLayout>

        <!-- FREQUENCY SELECTOR -->
        <LinearLayout
            android:id="@+id/frequencyBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#0A000000"
            android:padding="8dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/header">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn315"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="315"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:strokeColor="@color/info"
                android:textColor="@color/info"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn390"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="390"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:strokeColor="@color/info"
                android:textColor="@color/info"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn433"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="433"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:backgroundTint="@color/info"
                android:textColor="#000000"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn868"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="868"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:strokeColor="@color/info"
                android:textColor="@color/info"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn915"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="915"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:strokeColor="@color/info"
                android:textColor="@color/info"/>
        </LinearLayout>

        <!-- DATA FLOW INDICATOR -->
        <include
            android:id="@+id/dataFlow"
            layout="@layout/view_data_flow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/frequencyBar"/>

        <!-- CONTENT AREA WITH STATES -->
        <FrameLayout
            android:id="@+id/contentArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/dataFlow"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- IDLE STATE -->
            <LinearLayout
                android:id="@+id/idleState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP START TO SCAN"
                    android:textColor="@color/info"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select frequency and press the button below"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- SCANNING STATE -->
            <LinearLayout
                android:id="@+id/scanningState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/info"/>

                <TextView
                    android:id="@+id/scanningText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scanning..."
                    android:textColor="@color/info"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="16dp"
                    android:textIsSelectable="true"/>

                <TextView
                    android:id="@+id/signalCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 SIGNALS DETECTED"
                    android:textColor="@color/warning"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- RESULTS STATE -->
            <LinearLayout
                android:id="@+id/resultsState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SIGNALS FOUND"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/resultsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/warning"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textIsSelectable="true"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSignal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="SAVE SIGNAL"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    app:backgroundTint="@color/info"
                    android:textColor="#000000"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReplay"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="REPLAY SIGNAL"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    app:backgroundTint="@color/success"
                    android:textColor="#000000"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBruteForce"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="BRUTE FORCE"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    app:backgroundTint="@color/warning"
                    android:textColor="#000000"/>
            </LinearLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FAB CONTROL -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:text="START SCAN"
        android:textColor="#000000"
        android:fontFamily="monospace"
        app:backgroundTint="@color/func_subghz"
        app:icon="@android:drawable/ic_media_play"
        app:iconTint="#000000"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
