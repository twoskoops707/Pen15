<?xml version="1.0" encoding="utf-8"?>
<!-- INTUITIVE FAB-BASED SUB-GHZ INTERFACE -->
<!-- Primary: FAB (green=start, red=stop) | Secondary: Frequency selection -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grid_pattern">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="#DD000000"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:elevation="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="#00FFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⬡ SUB-GHZ"
                android:textColor="#FF0055"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginStart="12dp"/>

            <TextView
                android:id="@+id/frequencyDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="433.92"
                android:textColor="#FFFF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:background="#22FFFF00"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>

        <!-- FREQUENCY SELECTOR -->
        <LinearLayout
            android:id="@+id/frequencyBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#0A000000"
            android:padding="8dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/header">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn315"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="315"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:strokeColor="#00FFFF"
                android:textColor="#00FFFF"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn390"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="390"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:strokeColor="#00FFFF"
                android:textColor="#00FFFF"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn433"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="433"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:backgroundTint="#00FFFF"
                android:textColor="#000000"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn868"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="868"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:strokeColor="#00FFFF"
                android:textColor="#00FFFF"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn915"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="915"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:strokeColor="#00FFFF"
                android:textColor="#00FFFF"/>
        </LinearLayout>

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:id="@+id/buttonBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/frequencyBar">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="SCAN"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:backgroundTint="@color/func_subghz"
                android:textColor="#000000"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRead"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="READ"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:strokeColor="#00FFFF"
                android:textColor="#00FFFF"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBruteForce"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="BRUTE"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:strokeColor="#FFFF00"
                android:textColor="#FFFF00"
                android:layout_marginEnd="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaved"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="SAVED"
                android:textSize="10sp"
                android:fontFamily="monospace"
                app:strokeColor="#00FFFF"
                android:textColor="#00FFFF"/>
        </LinearLayout>

        <!-- LOG OUTPUT -->
        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#0A000000"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/buttonBar"
            app:layout_constraintBottom_toTopOf="@id/btnStop">

            <TextView
                android:id="@+id/logOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF41"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"/>
        </ScrollView>

        <!-- STOP BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="STOP"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="monospace"
            app:backgroundTint="#FF0055"
            android:layout_margin="8dp"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
