<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grid_pattern">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/info"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PHONEINFOGA"
            android:textColor="@color/info"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginStart="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHONE OSINT"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Info card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#44000000"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHONEINFOGA — PHONE NUMBER OSINT"
                        android:textColor="@color/info"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Scans international phone numbers for carrier info, country, line type, social media presence, and reputation data via multiple OSINT sources."
                        android:textColor="@color/text_secondary"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Scan input card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#44000000"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHONE NUMBER"
                        android:textColor="@color/info"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxStrokeColor="@color/info"
                        app:hintTextColor="@color/info">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="+15551234567  (E.164 format)"
                            android:textColor="@color/success"
                            android:textColorHint="#808080"
                            android:fontFamily="monospace"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScan"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="SCAN NUMBER"
                        app:backgroundTint="@color/info"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        app:icon="@android:drawable/ic_media_play"
                        app:iconTint="#000000" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Install card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#44000000"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOOL SETUP"
                        android:textColor="@color/warning"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tries pkg → Go install → binary script. Requires Termux with golang available."
                        android:textColor="@color/text_secondary"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:layout_marginBottom="12dp"
                        android:lineSpacingMultiplier="1.3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInstall"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="INSTALL TOOL"
                        app:backgroundTint="@color/warning"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Output card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#22000000"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OUTPUT"
                        android:textColor="@color/info"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:layout_marginBottom="8dp" />

                    <ScrollView
                        android:id="@+id/outputScroll"
                        android:layout_width="match_parent"
                        android:layout_height="380dp">

                        <TextView
                            android:id="@+id/logOutput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enter a phone number and tap SCAN NUMBER.\nInstall phoneinfoga first if not already installed."
                            android:textColor="@color/success"
                            android:fontFamily="monospace"
                            android:textSize="12sp"
                            android:textIsSelectable="true" />
                    </ScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
