<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C14"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLIPPER TOOLS"
            android:textColor="#4A5B78"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="10dp" />

        <!-- Clone Key Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111B2E"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLONE KEY CARD"
                android:textColor="#FF6E40"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Read and copy proximity badges, key fobs, and access cards (125kHz RFID)"
                android:textColor="#4A5B78"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRfidRead"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="READ CARD"
                    android:textSize="11sp"
                    android:textColor="#FF6E40"
                    android:textStyle="bold"
                    android:background="#1E3050" />

                <Button
                    android:id="@+id/btnRfidEmulate"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="REPLAY"
                    android:textSize="11sp"
                    android:textColor="#7A8BA8"
                    android:background="#152238" />

                <Button
                    android:id="@+id/btnRfidList"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="SAVED"
                    android:textSize="11sp"
                    android:textColor="#4A5B78"
                    android:background="#152238" />
            </LinearLayout>
        </LinearLayout>

        <!-- Copy Remote -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111B2E"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COPY REMOTE CONTROL"
                android:textColor="#B388FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Capture and replay garage openers, gate remotes, car fobs, doorbells (Sub-GHz radio)"
                android:textColor="#4A5B78"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSubghzRx"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="CAPTURE"
                    android:textSize="11sp"
                    android:textColor="#B388FF"
                    android:textStyle="bold"
                    android:background="#1E3050" />

                <Button
                    android:id="@+id/btnSubghzTxFile"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="REPLAY"
                    android:textSize="11sp"
                    android:textColor="#7A8BA8"
                    android:background="#152238" />

                <Button
                    android:id="@+id/btnSubghzList"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="SAVED"
                    android:textSize="11sp"
                    android:textColor="#4A5B78"
                    android:background="#152238" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSubghzBrute"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="BRUTE FORCE (try all codes)"
                android:textSize="11sp"
                android:textColor="#FF1744"
                android:textStyle="bold"
                android:background="#1E3050" />
        </LinearLayout>

        <!-- NFC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111B2E"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NFC TAGS"
                android:textColor="#00FF41"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Detect and read NFC cards, tags, and payment systems (13.56 MHz)"
                android:textColor="#4A5B78"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnNfcFieldOn"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="SCAN ON"
                    android:textSize="11sp"
                    android:textColor="#00FF41"
                    android:textStyle="bold"
                    android:background="#1E3050" />

                <Button
                    android:id="@+id/btnNfcFieldOff"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="SCAN OFF"
                    android:textSize="11sp"
                    android:textColor="#7A8BA8"
                    android:background="#152238" />

                <Button
                    android:id="@+id/btnNfcList"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="SAVED"
                    android:textSize="11sp"
                    android:textColor="#4A5B78"
                    android:background="#152238" />
            </LinearLayout>
        </LinearLayout>

        <!-- IR Remote -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111B2E"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TV / AC REMOTE"
                android:textColor="#FF1744"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Learn and send infrared signals. Point any remote at Flipper to capture it."
                android:textColor="#4A5B78"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnIrRx"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="LEARN"
                    android:textSize="11sp"
                    android:textColor="#FF1744"
                    android:textStyle="bold"
                    android:background="#1E3050" />

                <Button
                    android:id="@+id/btnIrTx"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="SEND"
                    android:textSize="11sp"
                    android:textColor="#7A8BA8"
                    android:background="#152238" />

                <Button
                    android:id="@+id/btnIrList"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="SAVED"
                    android:textSize="11sp"
                    android:textColor="#4A5B78"
                    android:background="#152238" />
            </LinearLayout>
        </LinearLayout>

        <!-- iButton -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111B2E"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTERCOM KEYS"
                android:textColor="#00B8D4"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Read and clone Dallas/Cyfral/Metakom intercom keys. Touch key to Flipper."
                android:textColor="#4A5B78"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnIkeyRead"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="READ KEY"
                    android:textSize="11sp"
                    android:textColor="#00B8D4"
                    android:textStyle="bold"
                    android:background="#1E3050" />

                <Button
                    android:id="@+id/btnIkeyEmulate"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="CLONE"
                    android:textSize="11sp"
                    android:textColor="#7A8BA8"
                    android:background="#152238" />
            </LinearLayout>
        </LinearLayout>

        <!-- BadUSB + Storage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#111B2E"
                android:padding="14dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BAD USB"
                    android:textColor="#FF1744"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnBadusbList"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="PAYLOADS"
                    android:textSize="10sp"
                    android:textColor="#FF1744"
                    android:background="#1E3050" />

                <Button
                    android:id="@+id/btnBadusbDemo"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:text="DEMO"
                    android:textSize="10sp"
                    android:textColor="#4A5B78"
                    android:background="#152238" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#111B2E"
                android:padding="14dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FILES"
                    android:textColor="#7A8BA8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnStorageRoot"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="BROWSE SD"
                    android:textSize="10sp"
                    android:textColor="#7A8BA8"
                    android:background="#1E3050" />

                <Button
                    android:id="@+id/btnStorageInfo"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:text="SPACE"
                    android:textSize="10sp"
                    android:textColor="#4A5B78"
                    android:background="#152238" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
