<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C14"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE STATUS"
            android:textColor="#4A5B78"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="10dp" />

        <!-- Connection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111B2E"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/status_indicator" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="NOT CONNECTED"
                    android:textColor="#4A5B78"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/deviceNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Plug in Flipper Zero or ESP32 via USB OTG cable, then tap CONNECT below."
                android:textColor="#4A5B78"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="CONNECT DEVICE"
                android:textSize="14sp"
                android:textColor="#080C14"
                android:textStyle="bold"
                android:background="#00E5FF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnConnectFlipper"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="FLIPPER ONLY"
                    android:textSize="10sp"
                    android:textColor="#7A8BA8"
                    android:background="#152238" />

                <Button
                    android:id="@+id/btnConnectEsp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="ESP32 ONLY"
                    android:textSize="10sp"
                    android:textColor="#7A8BA8"
                    android:background="#152238" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:text="DISCONNECT"
                android:textSize="12sp"
                android:textColor="#FF1744"
                android:background="#1E3050"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Device Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111B2E"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVICE INFO"
                android:textColor="#00FF41"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deviceInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="#7A8BA8"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                android:text="Connect a device to view info" />

            <Button
                android:id="@+id/btnRefreshInfo"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="GET INFO"
                android:textSize="11sp"
                android:textColor="#00FF41"
                android:background="#1E3050" />
        </LinearLayout>

        <!-- Power -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111B2E"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POWER CONTROL"
                android:textColor="#FFD600"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Control 5V rail for AWOK board, reboot or shut down Flipper."
                android:textColor="#4A5B78"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn5vOn"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="5V ON"
                    android:textSize="11sp"
                    android:textColor="#00FF41"
                    android:textStyle="bold"
                    android:background="#1E3050" />

                <Button
                    android:id="@+id/btn5vOff"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="5V OFF"
                    android:textSize="11sp"
                    android:textColor="#FF1744"
                    android:background="#1E3050" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnReboot"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="REBOOT"
                    android:textSize="11sp"
                    android:textColor="#FFD600"
                    android:background="#152238" />

                <Button
                    android:id="@+id/btnShutdown"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="POWER OFF"
                    android:textSize="11sp"
                    android:textColor="#FF1744"
                    android:background="#152238" />
            </LinearLayout>
        </LinearLayout>

        <!-- App Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111B2E"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PEN15 v2.0.3"
                android:textColor="#E8F0FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Flipper Zero + ESP32 Marauder Companion"
                android:textColor="#4A5B78"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Only use on networks and devices you own or have authorization to test."
                android:textColor="#FFD600"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
