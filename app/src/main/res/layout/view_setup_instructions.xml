<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSetupHelp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/surface_raised"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/primary"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="START HERE"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="Do these once. When the phone asks, always tap YES or ALLOW."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textSetupSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="8dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:text="1. Plug the cable in.\n   Flipper → your phone.\n   AWOK wires → Flipper pins 13 &amp; 14.\n\n2. A box pops up on the phone.\n   Tap OK. Tap YES. Tap ALLOW.\n\n3. The app wakes up Pen15 Controller\n   on the Flipper for you. Wait a few seconds.\n\n4. Phone asks about Bluetooth?\n   Tap ALLOW.\n\n5. Phone asks about Location?\n   Tap ALLOW. (WiFi needs this.)\n\n6. Phone asks about Files or Photos?\n   Tap ALLOW. (Saves your stuff.)\n\n7. Want the green Recon tools?\n   Tap the button below.\n   Install Termux. Open it once.\n   Come back here.\n\n8. AWOK turns green when the app\n   sees it through the Flipper." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenTermuxHelp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Get Termux (F-Droid)"
            android:textColor="@color/section_recon"
            app:strokeColor="@color/section_recon" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
