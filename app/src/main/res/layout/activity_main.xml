<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PEN15 PENTESTING SUITE"
            android:textSize="24sp"
            android:textColor="#00FFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="20dp"/>

        <!-- Flipper Tools Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔧 FLIPPER ZERO TOOLS"
            android:textSize="16sp"
            android:textColor="#00FF41"
            android:textStyle="bold"
            android:padding="8dp"/>

        <Button
            android:id="@+id/btnRFID"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="RFID READER"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnNFC"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="NFC READER"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnSubGHz"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="SUB-GHZ SCANNER"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnInfrared"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="INFRARED"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnIButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="iBUTTON READER"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnGPIO"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="GPIO CONTROL"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnBadUSB"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="BadUSB"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"
            android:layout_marginBottom="16dp"/>

        <!-- ESP32 Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📶 ESP32 MARAUDER"
            android:textSize="16sp"
            android:textColor="#FF00FF"
            android:textStyle="bold"
            android:padding="8dp"/>

        <Button
            android:id="@+id/btnESP32"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ESP32 MANAGER"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"
            android:layout_marginBottom="16dp"/>

        <!-- Settings -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="⚙️ SETTINGS"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A1A1A"/>

    </LinearLayout>
</ScrollView>
