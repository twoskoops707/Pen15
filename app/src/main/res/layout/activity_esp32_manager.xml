<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grid_pattern">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/info"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ESP32 / AWOK MANAGER"
            android:textColor="@color/danger"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginStart="12dp"/>

        <ImageView
            android:id="@+id/btnHelp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_help"
            android:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Help"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#1A000000"
        app:layout_constraintTop_toBottomOf="@id/header">

        <TextView
            android:id="@+id/statusFlipper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="Flipper USB: --"/>

        <TextView
            android:id="@+id/statusBridge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="AWOK: --"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/statusBanner"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="CONNECT"
                app:backgroundTint="@color/success"
                android:textColor="#000000"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#44000000"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WIFI ATTACKS"
                        android:textColor="@color/info"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanNetworks"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="SCAN NETWORKS"
                        app:backgroundTint="@color/info"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateAP"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="EVIL TWIN AP"
                        app:backgroundTint="@color/warning"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeauth"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="DEAUTH ATTACK"
                        app:backgroundTint="@color/danger"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSniff"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="PACKET SNIFFING"
                        app:backgroundTint="@color/success"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#44000000"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BLE ATTACKS"
                        android:textColor="@color/info"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBleScan"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="BLE SCAN &amp; SPAM"
                        app:backgroundTint="@color/info"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="STOP ALL"
                android:textColor="#000000"
                android:textStyle="bold"
                android:fontFamily="monospace"
                app:backgroundTint="@color/danger"
                android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#22000000"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:gravity="center_vertical"
                        android:background="#33000000">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TERMINAL OUTPUT"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="monospace"
                            android:textSize="11sp"
                            android:textStyle="bold"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScrollLock"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:text="AUTO-SCROLL"
                            android:textSize="9sp"
                            android:fontFamily="monospace"
                            app:backgroundTint="@color/success"
                            android:textColor="#000000"
                            app:cornerRadius="4dp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"/>

                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/logScroll"
                        android:layout_width="match_parent"
                        android:layout_height="380dp"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/logOutput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ESP32/AWOK Manager ready..."
                            android:textColor="@color/success"
                            android:fontFamily="monospace"
                            android:textSize="12sp"/>
                    </ScrollView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
