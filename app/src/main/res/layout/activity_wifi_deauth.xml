<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grid_pattern">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:elevation="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/info"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WIFI DEAUTH"
                android:textColor="@color/danger"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:layout_marginStart="12dp"/>

            <TextView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STANDBY"
                android:textColor="@color/warning"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:background="#22FFFF00"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>

        <!-- CONTENT AREA WITH STATES -->
        <FrameLayout
            android:id="@+id/contentArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- IDLE STATE -->
            <LinearLayout
                android:id="@+id/idleState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAP START TO SCAN"
                    android:textColor="@color/info"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan for nearby WiFi networks"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- SCANNING STATE -->
            <LinearLayout
                android:id="@+id/scanningState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/info"/>

                <TextView
                    android:id="@+id/scanningText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scanning networks..."
                    android:textColor="@color/info"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/networkCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 NETWORKS FOUND"
                    android:textColor="@color/warning"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- RESULTS STATE -->
            <LinearLayout
                android:id="@+id/resultsState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="NETWORKS"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/resultsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 APs"
                        android:textColor="@color/warning"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/networkList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#0A000000"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectTarget"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="SELECT TARGET"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    app:backgroundTint="@color/info"
                    android:textColor="#000000"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeauth"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="DEAUTH ATTACK"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    app:backgroundTint="@color/danger"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCapture"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="CAPTURE HANDSHAKE"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    app:backgroundTint="@color/warning"
                    android:textColor="#000000"/>
            </LinearLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FAB CONTROL -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabControl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:text="START SCAN"
        android:textColor="#000000"
        android:fontFamily="monospace"
        app:backgroundTint="@color/func_wifi"
        app:icon="@android:drawable/ic_media_play"
        app:iconTint="#000000"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
