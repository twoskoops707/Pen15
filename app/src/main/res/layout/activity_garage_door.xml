<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Garage Door / Rolling Code"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Connection Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">
            <View
                android:id="@+id/connectionDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_status_dot" />
            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Flipper: Not connected"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Mode Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tabScan"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="SCAN"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_button_active"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tabBrute"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="BRUTE FORCE"
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_button"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tabReplay"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="REPLAY"
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_button" />
        </LinearLayout>

        <!-- Scan Tab Content -->
        <LinearLayout
            android:id="@+id/scanTabContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INSTRUCTIONS"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Point Flipper at the garage door opener remote&#10;2. Press START to record the Sub-GHz signal&#10;3. Press the remote button within 10 seconds&#10;4. Flipper captures the raw rolling code signal&#10;5. Save to replay later"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <!-- Captured Signals -->
            <LinearLayout
                android:id="@+id/signalsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAPTURED SIGNALS"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvSignalCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No signals captured yet"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/signalList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Brute Force Tab Content -->
        <LinearLayout
            android:id="@+id/bruteTabContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WARNING"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This will rapidly transmit rolling codes.&#10;Only use on your own garage door.&#10;The Flipper will cycle through common&#10;rolling code algorithms."
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGET FREQUENCY"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinnerFrequency"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROTOCOL"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinnerProtocol"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner" />
            </LinearLayout>

            <!-- Brute Force Progress -->
            <LinearLayout
                android:id="@+id/bruteProgressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BRUTE FORCE IN PROGRESS"
                    android:textColor="@color/danger"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <ProgressBar
                    android:id="@+id/progressBrute"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvBruteStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Testing codes..."
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvBruteProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 0"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Replay Tab Content -->
        <LinearLayout
            android:id="@+id/replayTabContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVED SIGNALS"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select a previously captured signal to replay."
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/replayList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp" />

            <TextView
                android:id="@+id/tvNoSignals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No saved signals. Go scan some first!"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginTop="32dp" />
        </LinearLayout>

        <!-- Console Output -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="80dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONSOLE"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <ScrollView
                android:id="@+id/consoleScroll"
                android:layout_width="match_parent"
                android:layout_height="200dp">

                <TextView
                    android:id="@+id/tvConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ready.&#10;"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_output"
                    android:padding="8dp" />
            </ScrollView>
        </LinearLayout>

        <!-- FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="Start"
            android:backgroundTint="@color/accent"
            app:tint="@color/background"
            app:fabSize="normal" />

    </LinearLayout>
</ScrollView>
