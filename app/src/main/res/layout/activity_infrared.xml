<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grid_pattern">

    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/info"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="INFRARED"
            android:textColor="@color/danger"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginStart="12dp"/>

        <View
            android:id="@+id/connectionIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/status_dot"
            android:backgroundTint="@color/warning"/>

        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STANDBY"
            android:textColor="@color/warning"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>

        <ImageView
            android:id="@+id/btnHelp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_help"
            android:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Help"/>
    </LinearLayout>

    <include
        android:id="@+id/dataFlow"
        layout="@layout/view_data_flow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/statusBar"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#44000000"
        app:tabTextColor="@color/text_secondary"
        app:tabSelectedTextColor="@color/info"
        app:tabIndicatorColor="@color/info"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:tabTextAppearance="@android:style/TextAppearance.Small"
        app:layout_constraintTop_toBottomOf="@id/dataFlow">

        <com.google.android.material.tabs.TabItem
            android:text="LEARN"/>
        <com.google.android.material.tabs.TabItem
            android:text="TRANSMIT"/>
        <com.google.android.material.tabs.TabItem
            android:text="LIBRARY"/>
    </com.google.android.material.tabs.TabLayout>

    <!-- TRANSMIT TAB CONTENT -->
    <LinearLayout
        android:id="@+id/transmitTabContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRANSMIT IR SIGNAL"
            android:textColor="@color/info"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxStrokeColor="@color/info"
            app:hintTextColor="@color/info">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputTxProtocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Protocol (e.g. NECext, Samsung32)"
                android:textColor="@color/success"
                android:fontFamily="monospace"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxStrokeColor="@color/info"
            app:hintTextColor="@color/info">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputTxAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Address (hex, e.g. 0xA1)"
                android:textColor="@color/success"
                android:fontFamily="monospace"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxStrokeColor="@color/info"
            app:hintTextColor="@color/info">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputTxCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Command (hex, e.g. 0x09)"
                android:textColor="@color/success"
                android:fontFamily="monospace"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTransmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="TRANSMIT"
            app:backgroundTint="@color/info"
            android:textColor="#000000"
            android:textStyle="bold"
            android:fontFamily="monospace"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoadLastSignal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="LOAD LAST CAPTURED SIGNAL"
            android:textColor="@color/success"
            app:strokeColor="@color/success"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/txStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter signal details and press TRANSMIT"
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- LIBRARY TAB CONTENT -->
    <LinearLayout
        android:id="@+id/libraryTabContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IR SIGNAL LIBRARY"
            android:textColor="@color/info"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/noSavedIrText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No saved signals.\nCapture a signal in LEARN tab first."
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="48dp"/>

        <ListView
            android:id="@+id/savedIrList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/learnScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#44000000"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="OPERATION STATUS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/info"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:text="READY TO LEARN"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/success"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:text="Point remote at Flipper Zero IR receiver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#44000000"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="IR CONTROLS"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/info"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fabControl"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="START LEARN"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        app:icon="@android:drawable/ic_media_play"
                        app:iconTint="#000000"
                        app:backgroundTint="@color/info"
                        app:cornerRadius="0dp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStopLearn"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="STOP"
                        android:textColor="@color/danger"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        app:strokeColor="@color/danger"
                        app:strokeWidth="1dp"
                        app:cornerRadius="0dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#44000000"
                app:cardElevation="0dp"
                app:cardCornerRadius="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:text="SIGNAL DATA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/info"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/signalInfo"
                        android:text="Awaiting input..."
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
