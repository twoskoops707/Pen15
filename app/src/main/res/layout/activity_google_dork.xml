<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#13111C">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#1A1826"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#BD93F9"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GOOGLE DORKS"
            android:textColor="#F8F8F2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginStart="10dp"/>
    </LinearLayout>

    <!-- Tab Row -->
    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#1A1826">

        <TextView
            android:id="@+id/tabPerson"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="PERSON"
            android:textColor="#BD93F9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="#1A1826"/>

        <TextView
            android:id="@+id/tabOrg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ORG"
            android:textColor="#6272A4"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="#1A1826"/>

        <TextView
            android:id="@+id/tabBuilder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="BUILDER"
            android:textColor="#6272A4"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="#1A1826"/>

        <TextView
            android:id="@+id/tabLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="LIBRARY"
            android:textColor="#6272A4"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="center"
            android:background="#1A1826"/>
    </LinearLayout>

    <!-- Tab Indicator Bar -->
    <LinearLayout
        android:id="@+id/tabIndicatorRow"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:orientation="horizontal"
        android:background="#2A2840">

        <View
            android:id="@+id/indicatorPerson"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="#BD93F9"/>

        <View
            android:id="@+id/indicatorOrg"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="#2A2840"/>

        <View
            android:id="@+id/indicatorBuilder"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="#2A2840"/>

        <View
            android:id="@+id/indicatorLibrary"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="#2A2840"/>
    </LinearLayout>

    <!-- Content: each tab's layout included directly, toggled via visibility -->
    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==================== PERSON TAB ==================== -->
            <include
                android:id="@+id/panelPerson"
                layout="@layout/fragment_dork_person"/>

            <!-- ==================== ORG TAB ==================== -->
            <include
                android:id="@+id/panelOrg"
                layout="@layout/fragment_dork_org"
                android:visibility="gone"/>

            <!-- ==================== BUILDER TAB ==================== -->
            <include
                android:id="@+id/panelBuilder"
                layout="@layout/fragment_dork_builder"
                android:visibility="gone"/>

            <!-- ==================== LIBRARY TAB ==================== -->
            <include
                android:id="@+id/panelLibrary"
                layout="@layout/fragment_dork_library"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
