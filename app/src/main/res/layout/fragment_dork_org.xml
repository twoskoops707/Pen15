<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Section header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SEARCH AN ORGANIZATION"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Find exposed files, login pages, and sensitive data belonging to a company or website."
        android:textColor="#7878A0"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"/>

    <!-- Input Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0E0E1C"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <!-- Domain -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Domain  (required — the website address)"
            android:textColor="#EAEAF0"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/orgDomain"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="example.com"
            android:textColor="#EAEAF0"
            android:textColorHint="#3A3A58"
            android:background="#0A0A14"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp"
            android:inputType="textUri"
            android:layout_marginBottom="12dp"/>

        <!-- Company Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Company Name  (optional — the organization&#8217;s full name)"
            android:textColor="#EAEAF0"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/orgCompany"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Example Inc"
            android:textColor="#EAEAF0"
            android:textColorHint="#3A3A58"
            android:background="#0A0A14"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- Search Depth -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search Depth"
            android:textColor="#EAEAF0"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick = 4 queries  |  Standard = 8 queries  |  Deep = 13+ queries"
            android:textColor="#7878A0"
            android:textSize="11sp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/orgDepthGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/orgDepthQuick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quick"
                android:textColor="#EAEAF0"
                android:textSize="13sp"
                android:buttonTint="#00E5FF"/>

            <RadioButton
                android:id="@+id/orgDepthStandard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Standard"
                android:textColor="#EAEAF0"
                android:textSize="13sp"
                android:buttonTint="#00E5FF"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/orgDepthDeep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Deep"
                android:textColor="#EAEAF0"
                android:textSize="13sp"
                android:buttonTint="#00E5FF"/>

        </RadioGroup>

    </LinearLayout>

    <!-- Generate Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/orgGenerate"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="GENERATE DORKS"
        android:textColor="#0A0A14"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textSize="13sp"
        app:backgroundTint="#00E5FF"
        app:cornerRadius="4dp"
        android:layout_marginBottom="16dp"/>

    <!-- Results Card -->
    <LinearLayout
        android:id="@+id/orgResultsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0E0E1C"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GENERATED QUERIES"
            android:textColor="#7878A0"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:id="@+id/orgQueryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <!-- Bottom action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/orgSaveAll"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="SAVE ALL"
                android:textColor="#00FF88"
                android:textSize="12sp"
                android:fontFamily="monospace"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#00FF88"
                app:strokeWidth="1dp"
                app:cornerRadius="4dp"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/orgCopyAll"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="COPY ALL"
                android:textColor="#00B4D8"
                android:textSize="12sp"
                android:fontFamily="monospace"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="#00B4D8"
                app:strokeWidth="1dp"
                app:cornerRadius="4dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
