<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- 1. SCAN -->
        <LinearLayout
            android:id="@+id/headerScan"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/section_scan"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="1dp"
            android:layout_marginTop="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SCAN NETWORKS" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.05" />
            <TextView android:id="@+id/arrowScan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#9660;" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contentScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/section_content_bg"
            android:padding="12dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find nearby WiFi networks and connected devices. Scan first, then pick a target for attacks." android:textColor="#8899AA" android:textSize="11sp" android:layout_marginBottom="10dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnScanAp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="SCAN" android:textSize="10sp" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@color/section_scan" />
                <Button android:id="@+id/btnScanSta" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="CLIENTS" android:textSize="10sp" android:textColor="#E0E8F0" android:background="#1E2D45" />
                <Button android:id="@+id/btnListAp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="RESULTS" android:textSize="10sp" android:textColor="#8899AA" android:background="#1A2538" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnSelectAp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="PICK TARGET" android:textSize="10sp" android:textColor="#E0E8F0" android:background="#1E2D45" />
                <Button android:id="@+id/btnStopScan" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="STOP" android:textSize="10sp" android:textColor="#FFFFFF" android:background="#C62828" />
                <Button android:id="@+id/btnWardrive" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="WARDRIVE" android:textSize="10sp" android:textColor="#FFD740" android:background="#1E2D45" />
            </LinearLayout>
            <Button android:id="@+id/btnSigmon" android:layout_width="match_parent" android:layout_height="40dp" android:text="SIGNAL MONITOR" android:textSize="10sp" android:textColor="#8899AA" android:background="#1A2538" />
            <TextView android:id="@+id/statusScan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:textColor="#18FFFF" android:textSize="10sp" android:maxLines="8" android:visibility="gone" android:background="#060D15" android:padding="8dp" />
        </LinearLayout>

        <!-- 2. ATTACK -->
        <LinearLayout
            android:id="@+id/headerAttack"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/section_attack"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="1dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="WIFI ATTACKS" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.05" />
            <TextView android:id="@+id/arrowAttack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#9660;" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contentAttack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/section_content_bg"
            android:padding="12dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kick devices off WiFi, flood with fake networks, or create fake login pages to capture passwords." android:textColor="#8899AA" android:textSize="11sp" android:layout_marginBottom="10dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnDeauth" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="KICK OFF" android:textSize="10sp" android:textColor="#FFFFFF" android:textStyle="bold" android:background="#D50000" />
                <Button android:id="@+id/btnBeacon" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="FAKE APs" android:textSize="10sp" android:textColor="#FFFFFF" android:background="#F57F17" />
                <Button android:id="@+id/btnRickroll" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="RICKROLL" android:textSize="10sp" android:textColor="#FFD600" android:background="#1E2D45" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnProbe" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="PROBE" android:textSize="10sp" android:textColor="#E0E8F0" android:background="#1E2D45" />
                <Button android:id="@+id/btnEvilPortalStart" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="EVIL PORTAL" android:textSize="10sp" android:textColor="#FFFFFF" android:textStyle="bold" android:background="#FF6E40" />
                <Button android:id="@+id/btnEvilPortalStop" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="STOP" android:textSize="10sp" android:textColor="#FF8A80" android:background="#1A2538" />
            </LinearLayout>
            <Button android:id="@+id/btnKarma" android:layout_width="match_parent" android:layout_height="40dp" android:text="KARMA ATTACK" android:textSize="10sp" android:textColor="#FF8A80" android:background="#1A2538" />
            <TextView android:id="@+id/statusAttack" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:textColor="#FF8A80" android:textSize="10sp" android:maxLines="8" android:visibility="gone" android:background="#060D15" android:padding="8dp" />
        </LinearLayout>

        <!-- 3. CAPTURE -->
        <LinearLayout
            android:id="@+id/headerCapture"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/section_capture"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="1dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CAPTURE" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.05" />
            <TextView android:id="@+id/arrowCapture" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#9660;" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contentCapture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/section_content_bg"
            android:padding="12dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Capture WiFi handshakes for offline cracking. Sniff packets, detect skimmers, monitor probes." android:textColor="#8899AA" android:textSize="11sp" android:layout_marginBottom="10dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnSniffPmkid" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="PMKID" android:textSize="10sp" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@color/section_capture" />
                <Button android:id="@+id/btnSniffBeacon" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="BEACONS" android:textSize="10sp" android:textColor="#E0E8F0" android:background="#1E2D45" />
                <Button android:id="@+id/btnSniffDeauth" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="DEAUTHS" android:textSize="10sp" android:textColor="#E0E8F0" android:background="#1E2D45" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnSniffRaw" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="RAW" android:textSize="10sp" android:textColor="#8899AA" android:background="#1A2538" />
                <Button android:id="@+id/btnSniffProbe" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="PROBES" android:textSize="10sp" android:textColor="#8899AA" android:background="#1A2538" />
                <Button android:id="@+id/btnSniffSkim" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="SKIMMERS" android:textSize="10sp" android:textColor="#FF8A80" android:textStyle="bold" android:background="#1E2D45" />
            </LinearLayout>
            <TextView android:id="@+id/statusCapture" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:textColor="#69F0AE" android:textSize="10sp" android:maxLines="8" android:visibility="gone" android:background="#060D15" android:padding="8dp" />
        </LinearLayout>

        <!-- 4. CRACK -->
        <LinearLayout
            android:id="@+id/headerCrack"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/section_crack"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="1dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CRACK PASSWORD" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.05" />
            <TextView android:id="@+id/arrowCrack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#9660;" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contentCrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/section_content_bg"
            android:padding="12dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Crack captured handshakes. Quick = built-in dictionary. Termux = aircrack-ng with rockyou.txt (133MB)." android:textColor="#8899AA" android:textSize="11sp" android:layout_marginBottom="10dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnCrackWizard" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="CRACK WIZARD" android:textSize="10sp" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@color/section_crack" />
                <Button android:id="@+id/btnCrackInApp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="QUICK CRACK" android:textSize="10sp" android:textColor="#E0E8F0" android:background="#1E2D45" />
                <Button android:id="@+id/btnCrackTermux" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="TERMUX" android:textSize="10sp" android:textColor="#FFFFFF" android:background="#7C4DFF" />
            </LinearLayout>
            <Button android:id="@+id/btnDownloadWordlist" android:layout_width="match_parent" android:layout_height="40dp" android:text="DOWNLOAD WORDLIST (rockyou.txt)" android:textSize="10sp" android:textColor="#8899AA" android:background="#1A2538" />
            <TextView android:id="@+id/statusCrack" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:textColor="#FFD740" android:textSize="10sp" android:maxLines="8" android:visibility="gone" android:background="#060D15" android:padding="8dp" />
        </LinearLayout>

        <!-- 5. RECON -->
        <LinearLayout
            android:id="@+id/headerRecon"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/section_recon"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="1dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="RECON" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.05" />
            <TextView android:id="@+id/arrowRecon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#9660;" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contentRecon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/section_content_bg"
            android:padding="12dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Network reconnaissance. Scan for open ports, ping sweep subnets, join networks for internal testing." android:textColor="#8899AA" android:textSize="11sp" android:layout_marginBottom="10dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnPingScan" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="PING SWEEP" android:textSize="10sp" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@color/section_recon" />
                <Button android:id="@+id/btnPortScan" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="PORT SCAN" android:textSize="10sp" android:textColor="#E0E8F0" android:background="#1E2D45" />
                <Button android:id="@+id/btnJoinNetwork" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="JOIN NET" android:textSize="10sp" android:textColor="#E0E8F0" android:background="#1E2D45" />
            </LinearLayout>
            <TextView android:id="@+id/statusRecon" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:textColor="#CE93D8" android:textSize="10sp" android:maxLines="8" android:visibility="gone" android:background="#060D15" android:padding="8dp" />
        </LinearLayout>

        <!-- 6. BLUETOOTH -->
        <LinearLayout
            android:id="@+id/headerBluetooth"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/section_bluetooth"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="1dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="BLUETOOTH" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:letterSpacing="0.05" />
            <TextView android:id="@+id/arrowBluetooth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&#9660;" android:textColor="#FFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contentBluetooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/section_content_bg"
            android:padding="12dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Flood nearby phones with fake Bluetooth pairing popups. Sniff BT traffic and track AirTags." android:textColor="#8899AA" android:textSize="11sp" android:layout_marginBottom="10dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <Button android:id="@+id/btnBleSpam" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="BLE SPAM" android:textSize="10sp" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@color/section_bluetooth" />
                <Button android:id="@+id/btnSniffBt" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="SNIFF BT" android:textSize="10sp" android:textColor="#E0E8F0" android:background="#1E2D45" />
                <Button android:id="@+id/btnSniffAirtag" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="AIRTAGS" android:textSize="10sp" android:textColor="#E0E8F0" android:background="#1E2D45" />
            </LinearLayout>
            <Button android:id="@+id/btnBtWardrive" android:layout_width="match_parent" android:layout_height="40dp" android:text="BT WARDRIVE" android:textSize="10sp" android:textColor="#8899AA" android:background="#1A2538" />
            <TextView android:id="@+id/statusBle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="monospace" android:textColor="#40C4FF" android:textSize="10sp" android:maxLines="8" android:visibility="gone" android:background="#060D15" android:padding="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
