<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:clipToPadding="false"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WIFI / BLUETOOTH ATTACKS"
            android:textColor="#8899AA"
            android:textSize="13sp"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Scan Networks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141C2B"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIND NETWORKS"
                android:textColor="#18FFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Scan for nearby WiFi networks and connected devices. Scan first, then pick a target."
                android:textColor="#7888A0"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnScanAp"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="SCAN"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#00BCD4" />

                <Button
                    android:id="@+id/btnScanSta"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="CLIENTS"
                    android:textSize="11sp"
                    android:textColor="#E0E8F0"
                    android:background="#1E2D45" />

                <Button
                    android:id="@+id/btnListAp"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="RESULTS"
                    android:textSize="11sp"
                    android:textColor="#8899AA"
                    android:background="#1A2538" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSelectAp"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="PICK TARGET"
                    android:textSize="11sp"
                    android:textColor="#E0E8F0"
                    android:background="#1E2D45" />

                <Button
                    android:id="@+id/btnStopScan"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="STOP"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="#C62828" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="#18FFFF"
                android:textSize="10sp"
                android:maxLines="8"
                android:visibility="gone"
                android:background="#060D15"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Attacks -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141C2B"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WIFI ATTACKS"
                android:textColor="#FF5252"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kick devices off WiFi, flood with fake networks, or create fake login pages to capture passwords."
                android:textColor="#7888A0"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDeauth"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="KICK OFF"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#D50000" />

                <Button
                    android:id="@+id/btnBeacon"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="FAKE APs"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="#F57F17" />

                <Button
                    android:id="@+id/btnRickroll"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="RICKROLL"
                    android:textSize="11sp"
                    android:textColor="#FFD600"
                    android:background="#1E2D45" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnProbe"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="PROBE"
                    android:textSize="11sp"
                    android:textColor="#E0E8F0"
                    android:background="#1E2D45" />

                <Button
                    android:id="@+id/btnEvilPortalStart"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="EVIL PORTAL"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#FF6E40" />

                <Button
                    android:id="@+id/btnEvilPortalStop"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="STOP"
                    android:textSize="11sp"
                    android:textColor="#FF8A80"
                    android:background="#1A2538" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusAttack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="#FF8A80"
                android:textSize="10sp"
                android:maxLines="8"
                android:visibility="gone"
                android:background="#060D15"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Capture -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141C2B"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAPTURE PASSWORDS"
                android:textColor="#69F0AE"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Capture WiFi handshakes for offline password cracking. PMKID is fastest - no client needed."
                android:textColor="#7888A0"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSniffPmkid"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="PMKID"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#00C853" />

                <Button
                    android:id="@+id/btnSniffBeacon"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="BEACONS"
                    android:textSize="11sp"
                    android:textColor="#E0E8F0"
                    android:background="#1E2D45" />

                <Button
                    android:id="@+id/btnSniffDeauth"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="DEAUTHS"
                    android:textSize="11sp"
                    android:textColor="#E0E8F0"
                    android:background="#1E2D45" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSniffRaw"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="RAW"
                    android:textSize="11sp"
                    android:textColor="#8899AA"
                    android:background="#1A2538" />

                <Button
                    android:id="@+id/btnSniffProbe"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="PROBES"
                    android:textSize="11sp"
                    android:textColor="#8899AA"
                    android:background="#1A2538" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusCapture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="#69F0AE"
                android:textSize="10sp"
                android:maxLines="8"
                android:visibility="gone"
                android:background="#060D15"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Crack -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141C2B"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRACK WIFI PASSWORD"
                android:textColor="#FFD740"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Crack captured handshakes. Quick = built-in dictionary. Termux = aircrack-ng with rockyou.txt (133MB)."
                android:textColor="#7888A0"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCrackInApp"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="QUICK CRACK"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#F57F17" />

                <Button
                    android:id="@+id/btnCrackTermux"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="TERMUX"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="#7C4DFF" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDownloadWordlist"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:text="DOWNLOAD WORDLIST (rockyou.txt)"
                android:textSize="10sp"
                android:textColor="#8899AA"
                android:background="#1A2538" />
        </LinearLayout>

        <!-- BLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141C2B"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BLUETOOTH SPAM"
                android:textColor="#40C4FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Flood nearby phones with fake Bluetooth pairing popups. Sniff BT traffic and track AirTags."
                android:textColor="#7888A0"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBleSpam"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="BLE SPAM"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#0091EA" />

                <Button
                    android:id="@+id/btnSniffBt"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="SNIFF BT"
                    android:textSize="11sp"
                    android:textColor="#E0E8F0"
                    android:background="#1E2D45" />

                <Button
                    android:id="@+id/btnSniffAirtag"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="AIRTAGS"
                    android:textSize="11sp"
                    android:textColor="#E0E8F0"
                    android:background="#1E2D45" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusBle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="#40C4FF"
                android:textSize="10sp"
                android:maxLines="8"
                android:visibility="gone"
                android:background="#060D15"
                android:padding="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
