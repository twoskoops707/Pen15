<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PEN15 SETUP"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.10"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complete these steps to get started"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- Step 1: Termux -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <View
                        android:id="@+id/dotTermux"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/shape_status_dot"
                        android:backgroundTint="@color/status_disconnected"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1. Install &amp; Configure Termux"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textTermuxStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Checking..."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/textTermuxSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="① Install Termux from F-Droid (NOT Play Store)\n② Open Termux → run:\n   echo 'allow-external-apps=true' >> ~/.termux/termux.properties\n   termux-reload-settings\n③ Android Settings → Apps → Termux → Permissions → Files → Allow"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.4"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInstallTermux"
                    style="@style/Widget.Pen15.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OPEN F-DROID"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2: Flipper FAP -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <View
                        android:id="@+id/dotFlipper"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/shape_status_dot"
                        android:backgroundTint="@color/status_disconnected"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2. Install Pen15 FAP on Flipper"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textFlipperStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Checking..."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/background"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/textFlipperSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Requires Momentum or Unleashed firmware.\n\n① Build FAP: cd fap/pen15_controller\n② Copy pen15_controller.fap to Flipper SD:\n   Apps/GPIO/pen15_controller.fap\n③ On Flipper: Apps → GPIO → Pen15 Controller\n④ Connect Flipper to phone via USB-C"
                        android:textColor="@color/text_hint"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:lineSpacingMultiplier="1.4"
                        android:padding="12dp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestFlipper"
                    style="@style/Widget.Pen15.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TEST FLIPPER CONNECTION" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 3: ESP32 / AWOK -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <View
                        android:id="@+id/dotESP32"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/shape_status_dot"
                        android:backgroundTint="@color/status_disconnected"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3. Connect AWOK / ESP32 (WiFi attacks)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textESP32Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Optional — only needed for WiFi attacks"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connect AWOK via:\n• Direct USB to phone (OTG adapter)\n• GPIO pins 13/14 to Flipper Zero\n\nRequires ESP32 Marauder firmware:\ngithub.com/justcallmekoko/ESP32Marauder"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.4" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 4: Install Tools -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <View
                        android:id="@+id/dotTools"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/shape_status_dot"
                        android:backgroundTint="@color/status_disconnected"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4. Install Pentest Tools"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textToolsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Requires Termux to be configured first"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInstallTools"
                    style="@style/Widget.Pen15.Button.Success"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INSTALL TOOLS (nmap, sherlock, hashcat)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status Log -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/background"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="150dp">

                <TextView
                    android:id="@+id/logOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/success"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="Running setup checks..." />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- Skip / Continue -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkip"
            style="@style/Widget.Pen15.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SKIP — I'LL SET UP LATER"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/Widget.Pen15.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONTINUE TO APP" />

    </LinearLayout>
</ScrollView>
