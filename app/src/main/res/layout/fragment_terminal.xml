<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_void">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/bg_terminal">

        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_green" />

        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Terminal"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="STOP"
            android:textSize="10sp"
            android:textColor="@color/red"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="CLR"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/terminalRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:background="@color/bg_terminal"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/bg_surface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="H"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@color/bg_elevated"
            app:cornerRadius="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:hint="@string/command_hint"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:fontFamily="monospace"
            android:inputType="text"
            android:imeOptions="actionSend" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="56dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="GO"
            android:textSize="11sp"
            android:textColor="@color/bg_void"
            app:backgroundTint="@color/cyan"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
