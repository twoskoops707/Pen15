<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080C14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#0A0A0F">

        <View
            android:id="@+id/statusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_green" />

        <TextView
            android:id="@+id/statusLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Terminal"
            android:textSize="13sp"
            android:textColor="#4A5B78" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="STOP"
            android:textSize="11sp"
            android:textColor="#FF1744"
            android:background="@android:color/transparent"
            android:minWidth="48dp" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="CLR"
            android:textSize="11sp"
            android:textColor="#4A5B78"
            android:background="@android:color/transparent"
            android:minWidth="48dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/terminalRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:background="#0A0A0F"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="#0D1526">

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="H"
            android:textSize="13sp"
            android:textColor="#7A8BA8"
            android:background="#152238"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:hint="Type a command..."
            android:textColorHint="#4A5B78"
            android:textColor="#E8F0FF"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:fontFamily="monospace"
            android:inputType="text"
            android:imeOptions="actionSend" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:text="SEND"
            android:textSize="12sp"
            android:textColor="#080C14"
            android:textStyle="bold"
            android:background="#00E5FF" />
    </LinearLayout>

</LinearLayout>
